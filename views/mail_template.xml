<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Template for Maintenance Requests -->
        <record id="email_template_hotel_maintenance" model="mail.template">
            <field name="name">Hotel Maintenance: Assignment &amp; Reminder</field>
            <field name="model_id" ref="model_hotel_maintenance_request"/>
            <field name="subject">Maintenance Task Assigned: {{ object.name }} - Room {{ object.room_id.room_number }}</field>
            <field name="email_from">{{ user.email_formatted or 'admin@yourcompany.com' }}</field>
            <field name="email_to">{{ object.assigned_to.email or '' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: Arial, sans-serif;">
                    <p>Hello <strong t-out="object.assigned_to.name or 'Staff'"/>,</p>
                    <p>A maintenance request has been assigned to you or requires your attention:</p>
                    <ul style="list-style-type: square;">
                        <li><strong>Reference:</strong> <span t-out="object.name"/></li>
                        <li><strong>Room:</strong> <span t-out="object.room_id.room_number"/></li>
                        <li><strong>Issue Type:</strong> <span t-out="object.issue_type"/></li>
                        <li><strong>Urgency Level:</strong> <span t-out="object.urgency"/></li>
                        <li><strong>Scheduled Date:</strong> <span t-out="object.scheduled_date or 'Not Specified'"/></li>
                    </ul>
                    <p><strong>Description:</strong><br/>
                    <span t-out="object.description"/></p>
                    <p>Please log in to the Hotel Management system to take action.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>