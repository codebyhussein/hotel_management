<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree -->
    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.tree</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
        <tree string="Reservations"
            decoration-success="state == 'checked_in'"
            decoration-danger="state in ('cancelled', 'no_show')"
            decoration-info="state == 'confirmed'"
            decoration-primary="booking_type == 'group' and state in ('draft', 'confirmed')">
            <field name="name"/>
            <field name="booking_type" widget="badge"/>
            <field name="guest_id"/>
            <field name="property_id"/>
            <field name="room_display" string="Room(s)"/>
            <field name="check_in"/>
            <field name="check_out"/>
            <field name="nights"/>
            <field name="total_amount" sum="Total"/>
            <field name="currency_id" column_invisible="1"/>
            <field name="state" widget="badge"/>
        </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_register_deposit" string="Register Deposit" type="object"
                            invisible="state not in ('draft', 'confirmed') or deposit_paid or deposit_amount &lt;= 0"/>
                    <button name="action_check_in" string="Check In" type="object"
                        class="oe_highlight" invisible="state != 'confirmed'" />
                    <button name="action_check_out" string="Check Out" type="object"
                            class="oe_highlight" invisible="state != 'checked_in'"/>
                    <button name="action_change_room" string="Change Room" type="object"
                            invisible="state not in ('confirmed', 'checked_in') or booking_type == 'group'"/>
                    <button name="action_extend_stay" string="Extend Stay" type="object"
                            invisible="state not in ('confirmed', 'checked_in')"/>
                    <button name="action_no_show" string="No Show" type="object"
                        invisible="state != 'confirmed'" />
                    <!-- <button name="action_cancel" string="Cancel Reservation" type="object"
                        invisible="state != 'draft'" /> -->
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,checked_in,checked_out,cancelled" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_group" type="object" class="oe_stat_button" icon="fa-users" invisible="not group_ref">
                            <field name="group_count" widget="statinfo" string="Group"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="group_ref" invisible="not group_ref"/>
                    </div>
                    <group>
                        <group string="Booking Options">
                            <field name="booking_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="guest_id" readonly="state != 'draft'" />
                            <field name="room_id" readonly="state != 'draft'" invisible="booking_type != 'individual'" required="booking_type == 'individual'"/>
                            <field name="room_ids" widget="many2many_tags" readonly="state != 'draft'" invisible="booking_type != 'group'" required="booking_type == 'group'"/>
                            <field name="property_id" />
                            <field name="room_type" invisible="booking_type == 'group'"/>
                            <field name="source" />
                        </group>
                        <group string="Dates &amp; Guests">
                            <field name="check_in" readonly="state != 'draft'" />
                            <field name="check_out" readonly="state != 'draft'" />
                            <field name="actual_check_in" />
                            <field name="actual_check_out" />
                            <field name="adults" />
                            <field name="children" />
                        </group>
                    </group>
                    <group string="Pricing">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="nights"/>
                            <field name="nightly_rate" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="room_total"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group string="Deposit">
                        <group>
                            <field name="deposit_amount" readonly="(deposit_paid and deposit_amount > 0) or state not in ('draft', 'confirmed')"/>
                            <field name="deposit_paid" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="deposit_paid_date" invisible="not deposit_paid"/>
                        </group>
                        <group>
                            <field name="balance_after_deposit"/>
                            <field name="cancellation_fee" invisible="state not in ('cancelled', 'no_show')"/>
                            
                        </group>
                    </group>
                    <group>
                        <field name="responsible_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="special_request"/>
                        <field name="cancel_reason" invisible="state != 'cancelled'"/>
                        <field name="reminder_sent" invisible="1"/>
                    </group>
                    <notebook/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_hotel_reservation_kanban" model="ir.ui.view">
        <field name="name">hotel.reservation.kanban</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" group_create="false">
                <field name="state" />
                <field name="currency_id" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong>
                                <field name="name" />
                            </strong>
                            <div><field name="guest_id" /></div>
                            <div>Type: <field name="booking_type" /></div>
                            <div>
                                <field name="check_in" /> → <field name="check_out" /> (<field name="nights" /> nights) 
                            </div>
                            <div>
                                <field name="total_amount" widget="monetary"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="check_in" date_stop="check_out" color="state">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="room_ids"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="guest_id" />
                <field name="room_id" />
                <filter name="internal_reservations" string="Internal Reservations" domain="[('source', 'in', ['walk_in', 'phone', 'other'])]" />
                <filter name="external_reservations" string="External Reservations" domain="[('source', '=', 'website')]" />
                <filter name="individual_bookings" string="Individual Bookings" domain="[('booking_type', '=', 'individual')]" />
                <filter name="group_bookings" string="Group Bookings" domain="[('booking_type', '=', 'group')]" />
                <separator />
                <filter name="arrivals_today" string="Arrivals Today" domain="[('check_in', '=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'confirmed')]" />
                <filter name="departures_today" string="Departures Today" domain="[('check_out', '=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'checked_in')]" />
                <filter name="in_house" string="In-House" domain="[('state', '=', 'checked_in')]" />
                <group expand="0" string="Group By">
                    <filter name="group_booking_type" string="Booking Type" context="{'group_by': 'booking_type'}" />
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}" />
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
    </record>


</odoo>