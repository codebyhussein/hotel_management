<odoo>
    <!-- FIX F2: view_mode is NOT a field of ir.ui.view, so it must not be here.
         It belongs only on the act_window action record below. -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_in" string="Check-in" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_check_out" string="Check-out" type="object"
                            class="btn-primary" invisible="state != 'checked_in'"/>
                    <button name="action_no_show" string="No Show" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft','confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checked_in,checked_out"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="guest_id"/>
                            <field name="room_type_id"/>
                            <field name="room_id"/>
                            <field name="adults"/>
                            <field name="children"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="nights"/>
                            <field name="nightly_rate"/>
                            <field name="room_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.tree</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/><field name="guest_id"/><field name="room_id"/>
                <field name="check_in"/><field name="check_out"/><field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Kanban view  -->
      <record id="view_hotel_reservation_kanban" model="ir.ui.view">
        <field name="name">hotel.reservation.kanban</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="currency_id"/>
                <field name="room_total"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div>
                                <field name="guest_id" class="fw-bold"/>
                                <div class="text-muted"><field name="name"/></div>
                                <div>Room: <field name="room_id"/></div>
                                <div><field name="check_in"/> → <field name="check_out"/></div>
                            </div>
                            <div class="ms-auto text-end">
                                <field name="room_total" widget="monetary"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="check_in"
                      date_stop="check_out" mode="month">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <!-- FIX F2 (Haneen - Feature 3): enable the kanban + calendar views on the action -->
        <field name="view_mode">tree,form,kanban,calendar</field>
    </record>

    <menuitem id="menu_hotel_management_root" name="Hotel Management" sequence="10"/>
    <menuitem id="menu_hotel_reservation" name="Reservations"
              parent="menu_hotel_management_root" action="action_hotel_reservation" sequence="10"/>
</odoo>