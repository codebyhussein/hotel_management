<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree -->
    <record id="view_hotel_reservation_tree" model="ir.ui.view">
        <field name="name">hotel.reservation.tree</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <tree string="Reservations"
                  decoration-success="state == 'checked_in'"
                  decoration-danger="state in ('cancelled', 'no_show')"
                  decoration-info="state == 'confirmed'">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="property_id"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_check_in" string="Check In" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_check_out" string="Check Out" type="object"
                            class="oe_highlight" invisible="state != 'checked_in'"/>
                    <button name="action_no_show" string="No Show" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checked_in,checked_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Guest &amp; Room">
                            <field name="guest_id" readonly="state != 'draft'"/>
                            <field name="room_id" readonly="state != 'draft'"/>
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                            <field name="source"/>
                        </group>
                        <group string="Dates &amp; Guests">
                            <field name="check_in" readonly="state != 'draft'"/>
                            <field name="check_out" readonly="state != 'draft'"/>
                            <field name="actual_check_in"/>
                            <field name="actual_check_out"/>
                            <field name="adults"/>
                            <field name="children"/>
                        </group>
                    </group>
                    <group string="Pricing">
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="nights"/>
                            <field name="nightly_rate" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="room_total"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="responsible_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="special_request"/>
                        <field name="cancel_reason" invisible="state != 'cancelled'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_hotel_reservation_kanban" model="ir.ui.view">
        <field name="name">hotel.reservation.kanban</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" group_create="false">
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="guest_id"/></div>
                            <div>Room: <field name="room_id"/></div>
                            <div>
                                <field name="check_in"/> → <field name="check_out"/>
                                (<field name="nights"/> nights)
                            </div>
                            <div><field name="total_amount" widget="monetary"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar -->
    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="check_in" date_stop="check_out"
                      color="room_id" mode="month">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Search -->
    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <filter name="arrivals_today" string="Arrivals Today"
                        domain="[('check_in', '=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'confirmed')]"/>
                <filter name="departures_today" string="Departures Today"
                        domain="[('check_out', '=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'checked_in')]"/>
                <filter name="in_house" string="In-House" domain="[('state', '=', 'checked_in')]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_room" string="Room" context="{'group_by': 'room_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Cancel wizard -->
    <record id="view_hotel_reservation_cancel_wizard_form" model="ir.ui.view">
        <field name="name">hotel.reservation.cancel.wizard.form</field>
        <field name="model">hotel.reservation.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Reservation">
                <group>
                    <field name="reservation_id" invisible="1"/>
                    <field name="reason" placeholder="Why is this reservation cancelled?"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" string="Confirm Cancellation"
                            type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_hotel_root_temp" name="Hotel" sequence="10"/>
    <menuitem id="menu_hotel_reservation_root" name="Reservations"
              parent="menu_hotel_root_temp" sequence="20"/>
    <menuitem id="menu_hotel_reservation" name="All Reservations"
              parent="menu_hotel_reservation_root"
              action="action_hotel_reservation" sequence="10"/>
</odoo>