<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_hotel_housekeeping_task_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.tree</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <tree string="Room Service Requests">
                <field name="name"/>
                <field name="room_id"/>
                <field name="guest_id"/>
                <field name="request_date"/>
                <field name="assigned_user_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_housekeeping_task_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form string="Room Service Request">
                <header>
                    <field name="state" invisible="1"/>
                    <button name="action_mark_in_progress"
                            string="Start Work"
                            type="object"
                            invisible="state != 'new'"
                            class="oe_highlight"/>
                    <button name="action_mark_done"
                            string="Mark Done"
                            type="object"
                            invisible="state != 'in_progress'"
                            class="oe_highlight"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('done', 'cancel')"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Request Reference"/>
                        <h1>
                            <field name="name" placeholder="e.g. Room Service #101"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Target Info">
                            <field name="room_id"/>
                            <field name="guest_id"/>
                            <field name="request_date"/>
                        </group>
                    </group>

                    <group string="Select Required Services">
                        <group>
                            <field name="is_housekeeping"/>
                            <field name="is_food_ordering"/>
                            <field name="is_laundry"/>
                        </group>
                        <group>
                            <field name="is_extra_towels"/>
                            <field name="is_guest_supplies"/>
                        </group>
                    </group>

                    <!-- Service Options (Selection fields) -->
                    <group string="Service Options">
                        <field name="housekeeping_type" invisible="not is_housekeeping"/>
                        <field name="laundry_type" invisible="not is_laundry"/>
                        <field name="extra_towels_type" invisible="not is_extra_towels"/>
                        <field name="guest_supplies_type" invisible="not is_guest_supplies"/>
                    </group>

                    <!-- Food Items Table -->
                    <separator string="Food &amp; Drink Items" invisible="not is_food_ordering"/>
                    <field name="food_item_ids" invisible="not is_food_ordering">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="qty"/>
                            <field name="notes"/>
                        </tree>
                    </field>

                    <!-- Notebook -->
                    <notebook>
                        <page string="Special Instructions" name="instructions">
                            <field name="description" placeholder="Enter special instructions or guest preferences..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_housekeeping_task" model="ir.actions.act_window">
        <field name="name">Room Services</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
