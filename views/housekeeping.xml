<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_hotel_housekeeping_task_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.tree</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <tree string="Housekeeping Tasks">
                <field name="name"/>
                <field name="room_id"/>
                <field name="assigned_user_id"/>
                <field name="task_type"/>
                <field name="priority" widget="priority"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_housekeeping_task_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Task">
                <header>
                    <button name="action_mark_in_progress"
                            string="Start Work"
                            type="object"
                            invisible="state != 'todo'"
                            class="oe_highlight"/>
                    <button name="action_mark_done"
                            string="Mark Done"
                            type="object"
                            invisible="state != 'in_progress'"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Task Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Room 102 Deep Cleaning"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Task Details">
                            <field name="room_id"/>
                            <field name="task_type"/>
                            <field name="room_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Assignment &amp; Schedule">
                            <field name="assigned_user_id"/>
                            <field name="scheduled_date"/>
                            <field name="start_date" readonly="1"/>
                            <field name="done_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add detailed instructions or notes for the task..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hotel_housekeeping_task_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.search</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="room_id"/>

                <filter string="Urgent Priority" name="urgent_priority" domain="[('priority', '=', '5')]"/>
                <filter string="Scheduled Today" name="today" domain="[('scheduled_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_services" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_hotel_housekeeping_task_search"/>
    </record>


    <record id="action_hotel_housekeeping_task" model="ir.actions.act_window">
        <field name="name">Housekeeping Tasks</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>

