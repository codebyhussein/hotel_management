<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_hotel_housekeeping_task_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.tree</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <tree string="Housekeeping Tasks">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="task_type"/>
                <field name="maintenance_type"/>
                <field name="priority" widget="priority"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
                <field name="room_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hotel_housekeeping_task_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Task">
                <header>
                    <button name="action_mark_in_progress"
                            string="Start Work"
                            type="object"
                            invisible="state != 'todo'"
                            class="oe_highlight"/>
                    <button name="action_mark_done"
                            string="Mark Done"
                            type="object"
                            invisible="state != 'in_progress'"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,in_progress,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="task_type"/>
                            <field name="maintenance_type"
                                   invisible="task_type != 'maintenance'"
                                   required="task_type == 'maintenance'"/>
                            <field name="priority" widget="priority"/>
                            <field name="room_id"/>
                        </group>
                        <group>
                            <field name="assigned_user_id"/>
                            <field name="scheduled_date"/>
                            <field name="start_date" readonly="1"/>
                            <field name="done_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Add task details here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hotel_housekeeping_task_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.search</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">
                <field name="name"/>
                <field name="assigned_user_id"/>

                <filter string="Urgent Priority (5 Stars)" name="urgent_priority" domain="[('priority', '=', '5')]"/>
                <filter string="Scheduled Today" name="today" domain="[('scheduled_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Maintenance Tasks" name="maintenance" domain="[('task_type', '=', 'maintenance')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hotel_services" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_hotel_housekeeping_task_search"/>
    </record>

</odoo>