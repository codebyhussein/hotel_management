<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_users_form_hotel_property" model="ir.ui.view">
        <field name="name">res.users.form.hotel.property</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>

        <field name="arch" type="xml">

            <xpath expr="//page[@name='access_rights']" position="inside">

                <group string="Hotel"
                       groups="hotel_management.group_hotel_property_manager">

                    <field name="property_id"/>

                </group>

            </xpath>

        </field>
    </record>

</odoo>