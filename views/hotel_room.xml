<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================
         Room Tree View
    ========================== -->

    <record id="view_hotel_room_tree" model="ir.ui.view">
        <field name="name">hotel.room.tree</field>
        <field name="model">hotel.room</field>

        <field name="arch" type="xml">
            <tree string="Rooms">

                <field name="display_name" string="Room Number"/>
                <field name="room_type"/>
                <field name="price"/>
                <field name="employee_name" string="Responsible Employee"/>
                <field name="property_id"/>
                <field name="status"/>
                <field name="capacity"/>

            </tree>
        </field>
    </record>
<!-- =========================
     Room Form View
========================== -->

<record id="view_hotel_room_form" model="ir.ui.view">

    <field name="name">hotel.room.form</field>
    <field name="model">hotel.room</field>

    <field name="arch" type="xml">

        <form string="Room">

            <!-- Status Bar + Buttons -->

            <header>

                <button name="action_set_available"
                        string="Mark as Available"
                        type="object"
                        class="btn-primary"
                        invisible="status == 'available'"/>

                <button name="action_set_occupied"
                        string="Check-in"
                        type="object"
                        class="btn-primary"
                        invisible="status == 'occupied'"/>

                    <button name="action_set_maintenance"
                            string="Start Maintenance"
                            type="object"
                            invisible="status == 'maintenance'"/>

                    <button name="action_set_needs_cleaning"
                            string="Needs Cleaning"
                            type="object"
                            invisible="status == 'needs_cleaning'"/>
                    <button name="action_open_room_history_report"
                            string="Report"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_open_room_task_wizard" string="Create Service" type="object" class="oe_highlight"/>

                <field name="status"
                       widget="statusbar"
                       statusbar_visible="available,occupied,maintenance,needs_cleaning"/>

            </header>

                <sheet>

                    <!-- =========================
                         Smart Buttons
                    ========================== -->

                    <div class="oe_button_box" name="button_box">

                        <!-- Reservations Smart Button -->

                        <button name="action_view_reservations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">

                            <field name="reservation_count"
                                   widget="statinfo"
                                   string="Reservations"/>

                        </button>


                        <!-- Maintenance Smart Button -->

                        <button name="action_view_maintenance"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-wrench">

                            <field name="maintenance_count"
                                   widget="statinfo"
                                   string="Maintenance"/>

                        </button>

                    </div>


                 <field name="room_image" widget="image" class="oe_avatar"/>
                <!-- Room Number -->

                <div class="oe_title">

                    <label for="room_number"/>

                    <h1>
                        <field name="room_number"
                               placeholder="Enter Room Number"/>
                    </h1>

                </div>
 
                <group>

                    <group string="Room Information">

                        <field name="room_type"/>

                        <field name="price"/>

                        <field name="property_id"/>

                    </group>

                    <group string="Room Details">

                            <field name="capacity"/>

                            <field name="property_id"/>

                            <field name="employee_name"
                                   string="Responsible Employee"
                                   domain="[('property_id', '=', property_id)]"/>

                            <field name="status" readonly="1"/>

                    </group>

                </group>

                <!-- Description -->

                <separator string="Description"/>

                <group>

                    <field name="description"
                           placeholder="Enter room description..."
                           />

                </group>

            </sheet>

            <!-- =========================
                 Chatter
            ========================== -->

            <div class="oe_chatter">

                    <field name="message_follower_ids"
                           widget="mail_followers"/>

                    <field name="activity_ids"
                           widget="mail_activity"/>

                    <field name="message_ids"
                           widget="mail_thread"/>

            </div>

        </form>

    </field>

</record>
    <!-- =========================
         Room Search View
    ========================== -->

    <record id="view_hotel_room_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>

        <field name="arch" type="xml">

            <search string="Search Rooms">

                <!-- Search by typing -->

                <field name="room_number" string="Room Number"/>
                <field name="property_id"/>
                <field name="employee_name" string="Responsible Employee"/>


                <!-- Room Type Filters -->

                <filter string="Single"
                        name="filter_single"
                        domain="[('room_type', '=', 'single')]"/>

                <filter string="Double"
                        name="filter_double"
                        domain="[('room_type', '=', 'double')]"/>

                <filter string="Triple"
                        name="filter_triple"
                        domain="[('room_type', '=', 'triple')]"/>

                <filter string="Suite"
                        name="filter_suite"
                        domain="[('room_type', '=', 'suite')]"/>


                <separator/>


                <!-- Status Filters -->

                <filter string="Available"
                        name="filter_available"
                        domain="[('status', '=', 'available')]"/>

                <filter string="Occupied"
                        name="filter_occupied"
                        domain="[('status', '=', 'occupied')]"/>

                <filter string="Under Maintenance"
                        name="filter_maintenance"
                        domain="[('status', '=', 'maintenance')]"/>

                <filter string="Dirty / Needs Cleaning"
                        name="filter_needs_cleaning"
                        domain="[('status', '=', 'needs_cleaning')]"/>


                <!-- Group By -->

                <group expand="0" string="Group By">

                    <filter string="Room Type"
                            name="group_room_type"
                            context="{'group_by': 'room_type'}"/>

                    <filter string="Status"
                            name="group_status"
                            context="{'group_by': 'status'}"/>

                    <filter string="Property"
                            name="group_property"
                            context="{'group_by': 'property_id'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- =========================
         Room Action
    ========================== -->

    <record id="action_hotel_room" model="ir.actions.act_window">

        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>

        <field name="view_mode">tree,form</field>

        <field name="search_view_id"
               ref="view_hotel_room_search"/>

    </record>

</odoo>