<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main Menu -->
    <menuitem id="menu_hotel_management_root"
              name="Hotel Management"
              sequence="10"/>

    <!-- Rooms Parent -->
    <menuitem id="menu_hotel_rooms"
              name="Rooms"
              parent="menu_hotel_management_root"
              sequence="10"/>

    <!-- Rooms List -->
    <menuitem id="menu_hotel_rooms_list"
              name="Rooms"
              parent="menu_hotel_rooms"
              action="action_hotel_room"
              sequence="10"/>

    <!-- Properties -->
    <menuitem id="menu_hotel_properties"
              name="Properties"
              parent="menu_hotel_rooms"
              action="action_hotel_property"
              groups="hotel_management.group_hotel_property_manager"
              sequence="20"/>

    <!-- Guests -->
    <menuitem id="menu_hotel_guest"
              name="Guests"
              parent="menu_hotel_management_root"
              action="action_hotel_guest"
              sequence="30"/>

    <!-- Services Root Menu -->
    <menuitem id="menu_hotel_services_root"
              name="Services"
              parent="menu_hotel_management_root"
              sequence="40"/>

    <!-- Room Services -->
    <menuitem id="menu_hotel_housekeeping_task"
              name="Room Services"
              parent="menu_hotel_services_root"
              action="action_hotel_housekeeping_task"
              sequence="10"/>

    <!-- Maintenance Requests -->
    <menuitem id="menu_hotel_maintenance_request"
              name="Maintenance Requests"
              parent="menu_hotel_services_root"
              action="action_hotel_maintenance_request"
              sequence="20"/>

    <!-- Reservations Menu -->
    <menuitem id="menu_hotel_reservations"
            name="Reservations"
            parent="menu_hotel_management_root"
            action="action_hotel_reservation"
            sequence="50"/>

    <!-- Billing -->
    <menuitem id="menu_hotel_billing" name="Billing" parent="menu_hotel_management_root" sequence="60"/>
    <menuitem id="menu_hotel_folio_line" name="Folio Lines" parent="menu_hotel_billing" action="action_hotel_folio_line" sequence="70"/>
    <menuitem id="menu_hotel_payment" name="Payments" parent="menu_hotel_billing" action="action_hotel_payment" sequence="80"/>

    <!-- Reports -->
    <menuitem id="menu_hotel_reports_root" name="Reports"
              parent="menu_hotel_management_root" sequence="90"/>


    <menuitem id="menu_hotel_reservation_report" name="Reservation Report"
              parent="menu_hotel_reports_root"
              action="action_hotel_reservation_report_wizard"
              sequence="20"/>

<menuitem id="menu_occupancy_revenue"
              name="Rooms Report"
              parent="menu_hotel_reports_root"
              action="action_room_history_wizard"
              sequence="30"/>

</odoo>
 