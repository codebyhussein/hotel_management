<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_room_history_wizard_form" model="ir.ui.view">
        <field name="name">hotel.room.history.wizard.form</field>
        <field name="model">hotel.room.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Room History Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Generate PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_room_history_wizard" model="ir.actions.act_window">
        <field name="name">Room History Report</field>
        <field name="res_model">hotel.room.history.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_room_history_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>