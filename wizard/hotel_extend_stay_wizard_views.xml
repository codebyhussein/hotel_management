<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_extend_stay_wizard_form" model="ir.ui.view">
        <field name="name">hotel.reservation.extend.wizard.form</field>
        <field name="model">hotel.reservation.extend.wizard</field>
        <field name="arch" type="xml">
            <form string="Extend / Shorten Stay">
                <field name="reservation_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group string="Current">
                        <field name="room_id"/>
                        <field name="check_in"/>
                        <field name="current_check_out"/>
                        <field name="current_nights"/>
                        <field name="current_total"/>
                    </group>
                    <group string="New">
                        <field name="new_check_out"/>
                        <field name="new_nights"/>
                        <field name="new_total"/>
                        <field name="difference"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not availability_note">
                    <field name="availability_note" nolabel="1"/>
                </div>
                <group>
                    <field name="reason" placeholder="Guest wants to stay longer, early departure..."/>
                </group>
                <footer>
                    <button name="action_confirm_change" string="Apply"
                            type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>