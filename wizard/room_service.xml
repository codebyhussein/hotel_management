<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!-- Room Task Wizard Form                    -->
    <!-- ========================================= -->

    <record id="view_room_task_wizard_form" model="ir.ui.view">
        <field name="name">room.task.wizard.form</field>
        <field name="model">room.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Maintenance / Housekeeping">

                <group>
                    <field name="room_id"/>
                    <field name="task_type" widget="radio"/>
                </group>

                <separator string="Task Information"/>

                <group>
                    <field name="name" placeholder="Enter task title"/>

                    <field name="maintenance_type" invisible="task_type != 'maintenance'" required="task_type == 'maintenance'"/>
                    
                    <field name="assigned_user_id"/>

                    <field name="description" placeholder="Describe the task..."/>
                </group>

                <footer>
                    <button name="action_create_task" string="Create" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

    <!-- ========================================= -->
    <!-- Open Room Task Wizard                    -->
    <!-- ========================================= -->

    <record id="action_room_task_wizard" model="ir.actions.act_window">
        <field name="name">Create Maintenance / Housekeeping</field>
        <field name="res_model">room.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_room_task_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>