<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_room_history_report_wizard_form"
            model="ir.ui.view">

        <field name="name">room.history.report.wizard.form</field>

        <field name="model">room.history.report.wizard</field>

        <field name="arch" type="xml">

            <form string="Room History Report">

                <group>

                    <field name="room_id" readonly="1"/>

                    <field name="excel_file"
                           filename="excel_filename"
                           invisible="1"/>

                    <field name="excel_filename"
                           invisible="1"/>

                </group>

                <footer>

                    <button name="action_generate_report"
                            string="Generate Excel"
                            type="object"
                            class="oe_highlight"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>