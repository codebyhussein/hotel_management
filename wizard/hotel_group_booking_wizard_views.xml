<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_group_wizard_form" model="ir.ui.view">
        <field name="name">hotel.reservation.group.wizard.form</field>
        <field name="model">hotel.reservation.group.wizard</field>
        <field name="arch" type="xml">
            <form string="Group Booking">
                <group>
                    <group>
                        <field name="guest_id"/>
                        <field name="source"/>
                    </group>
                    <group>
                        <field name="check_in"/>
                        <field name="check_out"/>
                        <field name="confirm_now"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="room_id"/>
                        <field name="adults"/>
                        <field name="children"/>
                    </tree>
                </field>
                <group>
                    <field name="special_request"/>
                </group>
                <footer>
                    <button name="action_create_group" string="Create Reservations"
                            type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hotel_group_wizard" model="ir.actions.act_window">
        <field name="name">Group Booking</field>
        <field name="res_model">hotel.reservation.group.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>