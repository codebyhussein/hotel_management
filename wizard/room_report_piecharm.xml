<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Room Status Report Wizard Form -->
    <record id="view_room_status_report_wizard_form"
            model="ir.ui.view">

        <field name="name">room.status.report.wizard.form</field>

        <field name="model">room.status.report.wizard</field>

        <field name="arch" type="xml">

            <form string="Room Status Report">

                <group string="Report Period">

                    <field name="date_from"/>
                    <field name="date_to"/>

                </group>

                <group string="Filters">

                    <field name="property_id"
                           options="{'no_create': True}"/>

                    <field name="status"/>

                </group>

                <footer>

                    <button name="action_apply"
                            string="Apply"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>


    <!-- Wizard Action -->
    <record id="action_room_status_report_wizard"
            model="ir.actions.act_window">

        <field name="name">Room Status Report</field>

        <field name="res_model">room.status.report.wizard</field>

        <field name="view_mode">form</field>

        <field name="view_id"
               ref="view_room_status_report_wizard_form"/>

        <field name="target">new</field>

    </record>

</odoo>