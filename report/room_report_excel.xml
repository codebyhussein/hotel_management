<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================== -->
    <!-- Room History Excel Report Wizard Form         -->
    <!-- ============================================== -->

    <record id="view_room_history_report_wizard_form" model="ir.ui.view">

        <field name="name">room.history.report.wizard.form</field>
        <field name="model">room.history.report.wizard</field>

        <field name="arch" type="xml">

            <form string="Room History Report">

                <!-- Room Information -->
                <group>
                    <field name="room_id" readonly="1"/>
                </group>

                <!-- Date Filters -->
                <group string="Date Filters" col="2">

                    <field name="date_from"/>
                    <field name="date_to"/>

                </group>

                <!-- Report Sections -->
                <group string="Report Sections" col="2">

                    <field name="include_reservations"/>
                    <field name="include_tasks"/>

                </group>

                <!-- Task Type Filter -->
                <group string="Task Filters" col="2">

                    <field name="task_type"/>

                </group>

                <!-- Hidden Excel Fields -->
                <group invisible="1">

                    <field name="excel_file" filename="excel_filename"/>
                    <field name="excel_filename"/>

                </group>

                <!-- Buttons -->
                <footer>

                    <button name="action_generate_report"
                            string="Generate Excel"
                            type="object"
                            class="oe_highlight"/>

                    <button name="action_print_pdf"
                            string="Print PDF"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>

    </record>

</odoo>