<?xml version="1.0" encoding="utf-8"?>
<odoo>


<!-- ========================================================== 
Mail template: Reservation Confirmation Sent to the guest when a reservation is confirmed.
========================================================== -->
    <data noupdate="0">
        <record id="mail_template_reservation_confirmation" model="mail.template">
            <field name="name">Hotel: Reservation Confirmation</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="subject">Your reservation {{ object.name }} is confirmed 🎉</field>
            <field name="email_to">{{ object.guest_id.email }}</field>
            <field name="email_from">{{ (object.responsible_id.email_formatted or object.company_id.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="report_template_ids" eval="[(4, ref('hotel_management.action_report_hotel_reservation'))]"/>
            <field name="body_html" type="html">
<div style="margin:0; padding:0; font-family:Arial, Helvetica, sans-serif; color:#2d2d2d;">
  <table style="width:100%; max-width:600px; margin:auto; border-collapse:collapse;">
    <tr>
      <td style="background-color:#6f42c1; color:#ffffff; padding:24px; text-align:center;">
        <div style="font-size:12px; letter-spacing:2px; text-transform:uppercase; color:#e6dcf7;">Reservation Confirmed</div>
        <div style="font-size:26px; font-weight:bold; margin-top:6px;">Welcome, <t t-out="object.guest_id.display_name"/>!</div>
      </td>
    </tr>
    <tr>
      <td style="padding:24px; background-color:#ffffff;">
        <p>We are delighted to confirm your stay with us. We can't wait to welcome you!</p>

        <table style="width:100%; border-collapse:collapse; margin:16px 0;">
          <tr style="background-color:#f6f1fd;">
            <td style="padding:10px; font-weight:bold;">Reservation No.</td>
            <td style="padding:10px;"><t t-out="object.name"/></td>
          </tr>
          <tr>
            <td style="padding:10px; font-weight:bold;">Hotel</td>
            <td style="padding:10px;"><t t-out="object.property_id.name or object.company_id.name"/></td>
          </tr>
          <tr style="background-color:#f6f1fd;">
            <td style="padding:10px; font-weight:bold;">Room</td>
            <td style="padding:10px;"><t t-out="object.room_id.display_name"/></td>
          </tr>
          <tr>
            <td style="padding:10px; font-weight:bold;">Check-in</td>
            <td style="padding:10px;"><t t-out="object.check_in"/></td>
          </tr>
          <tr style="background-color:#f6f1fd;">
            <td style="padding:10px; font-weight:bold;">Check-out</td>
            <td style="padding:10px;"><t t-out="object.check_out"/></td>
          </tr>
          <tr>
            <td style="padding:10px; font-weight:bold;">Nights</td>
            <td style="padding:10px;"><t t-out="object.nights"/></td>
          </tr>
          <tr style="background-color:#f6f1fd;">
            <td style="padding:10px; font-weight:bold;">Guests</td>
            <td style="padding:10px;"><t t-out="object.adults"/> adult(s), <t t-out="object.children"/> child(ren)</td>
          </tr>
          <tr>
            <td style="padding:10px; font-weight:bold;">Total</td>
            <td style="padding:10px; color:#6f42c1; font-weight:bold;">
              <t t-out="format_amount(object.total_amount, object.currency_id)"/>
            </td>
          </tr>
        </table>

        <div t-if="object.special_request" style="border-left:4px solid #6f42c1; background-color:#f6f1fd; padding:10px 14px; margin-bottom:16px;">
          <strong>Your special request:</strong> <t t-out="object.special_request"/>
        </div>

        <h3 style="color:#6f42c1; margin-bottom:6px;">Terms &amp; Conditions</h3>
        <ul style="padding-left:18px; line-height:1.7;">
          <li>Check-in is from 2:00 PM and check-out is until 12:00 PM.</li>
          <li>A valid photo ID or passport is required at check-in.</li>
          <li>Free cancellation up to 48 hours before arrival.</li>
          <li>Late arrivals: please inform us so we can hold your room.</li>
          <li>Non-arrival without notice is treated as a No-Show.</li>
          <li>Smoking is not allowed inside the rooms.</li>
        </ul>

        <p>Your reservation confirmation is attached as a PDF.</p>
        <p>If you have any questions, just reply to this email.</p>
        <p style="margin-top:24px;">Warm regards,<br/>
           <strong><t t-out="object.company_id.name"/></strong></p>
      </td>
    </tr>
    <tr>
      <td style="background-color:#5b2d90; color:#e6dcf7; text-align:center; padding:12px; font-size:12px;">
        Thank you for choosing us.
      </td>
    </tr>
  </table>
</div>
            </field>
        </record>
    </data>
</odoo>