<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================
         Reservation Sequence
         Example: RES/2026/0001
    ========================== -->
    <record id="seq_hotel_reservation" model="ir.sequence">
        <field name="name">Hotel Reservation Sequence</field>
        <field name="code">hotel.reservation.sequence</field>
        <field name="prefix">RES/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- =========================
         Group Booking Sequence
         Example: GRP-0001
    ========================== -->
    <record id="seq_hotel_group" model="ir.sequence">
        <field name="name">Hotel Group Booking Sequence</field>
        <field name="code">hotel.group.sequence</field>
        <field name="prefix">GRP-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- =========================
         Cron: Check No-Show Reservations
    ========================== -->
    <record id="ir_cron_check_no_show_reservations" model="ir.cron">
        <field name="name">Hotel: Check No-Show Reservations</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_no_show()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- =========================
         Cron: Automatic Check-Out
    ========================== -->
    <record id="ir_cron_auto_check_out" model="ir.cron">
        <field name="name">Hotel: Auto Check-out</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_check_out()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>