<odoo>
    <record id="ir_cron_hotel_reservation_no_show" model="ir.cron">
        <field name="name">Hotel: Mark Late Reservations as No Show</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_no_show()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>